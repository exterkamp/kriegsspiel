{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules-table.schema.json",
  "title": "A rules table with provenance",
  "type": "object",
  "required": ["id", "title", "edition", "source", "data"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 1 },
    "edition": { "enum": ["1824", "1828", "later"] },
    "source": { "$ref": "#/$defs/sourceRef" },
    "cross_check": { "$ref": "#/$defs/sourceRef" },
    "data": { "type": "object" },
    "gaps": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["source", "locator"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      }
    }
  }
}
