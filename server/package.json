{
  "name": "@kriegsspiel/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:orders": "tsc -p tsconfig.build.json && node dist/orders/eval/cli.js",
    "bench:ollama": "tsc -p tsconfig.build.json && node dist/umpire/ollamaBench.js",
    "bench:umpire": "tsc -p tsconfig.build.json && node dist/umpire/eval/benchCli.js",
    "start": "node dist/main.js",
    "dev": "npm run build -w @kriegsspiel/engine -w @kriegsspiel/protocol && tsc -p tsconfig.build.json && node dist/main.js",
    "replay": "tsc -p tsconfig.build.json && node dist/game/replayCli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@kriegsspiel/engine": "*",
    "@kriegsspiel/protocol": "*",
    "ajv": "^8.20.0",
    "fastify": "^5.12.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4"
  }
}
