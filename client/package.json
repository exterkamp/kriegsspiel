{
  "name": "@kriegsspiel/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/prepare-local-map-default.mjs && ng serve --host 0.0.0.0 --port \"${PORT:-4200}\"",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "node ../scripts/prepare-local-map-default.mjs && ng test --watch=false && vitest run",
    "build:development": "node ../scripts/prepare-local-map-default.mjs && ng build --configuration development"
  },
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@kriegsspiel/protocol": "*",
    "rxjs": "^7.8.0",
    "three": "^0.170.0",
    "tslib": "^2.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/three": "^0.170.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2"
  }
}
