# Copy to .env (git-ignored). Compose passes it to the server.
KRIEGSSPIEL_PORT=3000
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
# ANTHROPIC_API_KEY=   (unset: the umpire uses the small local Ollama model, falling back to canned `test` responses)
# UMPIRE_KEYLESS_PROVIDER=ollama   (or `test` for canned responses only)
# OLLAMA_MODEL=qwen2.5:0.5b   (pulled on first start; OLLAMA_URL, OLLAMA_NUM_CTX, OLLAMA_TIMEOUT_MS, OLLAMA_PORT, OLLAMA_BIND, OLLAMA_KEEP_ALIVE)
# PUBLIC_URL=https://kriegsspiel.example
# ALLOWED_ORIGINS=
# TRUST_PROXY=1
# GUEST_PLAY=1 lets visitors play with no email (default on in development, off when NODE_ENV=production; the compose file sets it on)
# GUEST_PER_HOUR=60 caps guests created per client address per hour; raise it when a proxy hides client addresses and TRUST_PROXY is off
# GUEST_IDLE_HOURS=168
# ADMIN_ENABLED=1 mounts the read-only admin view; ADMIN_OPEN=1 lets anyone use it with no token (demo only: never expose the port; refused under NODE_ENV=production unless ADMIN_OPEN_FORCE=1)
# DEV_TOOLS=0 hides the main menu's Developer tools section (map editor, benchmarks, admin); default on outside production, the compose file sets it on
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_TOKEN=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
